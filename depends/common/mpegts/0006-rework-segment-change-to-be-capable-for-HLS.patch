From 5698e4c292256aee1c37c1495a2b88201c04c997 Mon Sep 17 00:00:00 2001
From: peak3d <pfau@peak3d.de>
Date: Mon, 7 Aug 2017 09:39:00 +0200
Subject: [PATCH 06/16] rework segment change to be capable for HLS

---
 src/ES_h264.cpp          | 3 +++
 src/ES_h264.h            | 1 +
 src/elementaryStream.cpp | 1 +
 src/elementaryStream.h   | 1 +
 4 files changed, 6 insertions(+)

diff --git a/src/ES_h264.cpp b/src/ES_h264.cpp
index f94f9bb..589341a 100644
--- a/src/ES_h264.cpp
+++ b/src/ES_h264.cpp
@@ -74,6 +74,7 @@ void ES_h264::Parse(STREAM_PKT* pkt)
   size_t pOld = es_parsed, p = es_parsed;
   uint32_t startcode = m_StartCode;
   bool frameComplete = false;
+  m_recoveryPoint = false;
 
   while ((p + 3) < es_len)
   {
@@ -124,6 +125,7 @@ void ES_h264::Parse(STREAM_PKT* pkt)
       pkt->pts            = m_PTS;
       pkt->duration       = duration;
       pkt->streamChange   = SetVideoInformation(duration, PTS_TIME_BASE, m_Height, m_Width, static_cast<float>(DAR), m_Interlaced);
+      pkt->recoveryPoint  = m_recoveryPoint;
 
       if (es_extraDataChanged)
       {
@@ -333,6 +335,7 @@ bool ES_h264::Parse_SLH(uint8_t *buf, int len, h264_private::VCL_NAL &vcl)
   case 1:
     break;
   case 2:
+    m_recoveryPoint = true;
     m_NeedIFrame = false;
     break;
   default:
diff --git a/src/ES_h264.h b/src/ES_h264.h
index 23c1656..6bcd449 100644
--- a/src/ES_h264.h
+++ b/src/ES_h264.h
@@ -97,6 +97,7 @@ namespace TSDemux
     int64_t         m_DTS;
     int64_t         m_PTS;
     bool            m_Interlaced;
+    bool            m_recoveryPoint;
 
     int             m_SPSRawId;
     int             m_PPSRawId;
diff --git a/src/elementaryStream.cpp b/src/elementaryStream.cpp
index b61281f..039f154 100644
--- a/src/elementaryStream.cpp
+++ b/src/elementaryStream.cpp
@@ -216,6 +216,7 @@ void ElementaryStream::ResetStreamPacket(STREAM_PKT* pkt)
   pkt->pts                = PTS_UNSET;
   pkt->duration           = 0;
   pkt->streamChange       = false;
+  pkt->recoveryPoint      = false;
 }
 
 uint64_t ElementaryStream::Rescale(uint64_t a, uint64_t b, uint64_t c)
diff --git a/src/elementaryStream.h b/src/elementaryStream.h
index 6a49f37..9a5c6d5 100644
--- a/src/elementaryStream.h
+++ b/src/elementaryStream.h
@@ -86,6 +86,7 @@ namespace TSDemux
     int64_t               pts;
     uint64_t              duration;
     bool                  streamChange;
+    bool                  recoveryPoint;
   };
 
   class ElementaryStream
-- 
2.17.1.windows.2

