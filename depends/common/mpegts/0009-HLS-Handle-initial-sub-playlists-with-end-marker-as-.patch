From 2af963ba5247fb11fc2d591671f8ae1ea16ab17d Mon Sep 17 00:00:00 2001
From: peak3d <pfau@peak3d.de>
Date: Wed, 16 Aug 2017 19:31:32 +0200
Subject: [PATCH 09/16] [HLS] Handle initial sub playlists with end marker as
 VOD / seek fixes (tbc)

---
 src/ES_h264.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/ES_h264.cpp b/src/ES_h264.cpp
index 1fa1dc0..9e5e9dd 100644
--- a/src/ES_h264.cpp
+++ b/src/ES_h264.cpp
@@ -63,6 +63,7 @@ ES_h264::ES_h264(uint16_t pes_pid)
   m_PPSRawId                    = -1;
   m_fpsRate = 0;
   m_fpsScale = 0;
+  m_recoveryPoint = false;
   Reset();
 }
 
@@ -96,7 +97,6 @@ void ES_h264::Parse(STREAM_PKT* pkt)
   size_t pOld = es_parsed, p = es_parsed;
   uint32_t startcode = m_StartCode;
   bool frameComplete = false;
-  m_recoveryPoint = false;
 
   while ((p + 3) < es_len)
   {
@@ -180,6 +180,7 @@ void ES_h264::Parse(STREAM_PKT* pkt)
     es_parsed = es_consumed;
     es_found_frame = false;
     es_frame_valid = true;
+    m_recoveryPoint = false;
   }
 }
 
@@ -190,6 +191,7 @@ void ES_h264::Reset()
   m_NeedIFrame = true;
   m_NeedSPS = true;
   m_NeedPPS = true;
+  m_recoveryPoint = false;
   memset(&m_streamData, 0, sizeof(m_streamData));
 }
 
